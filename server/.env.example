# Порт HTTP-сервера
PORT=8787
# Токен доступу до адмін-панелі (обов'язково змініть у продакшені)
ADMIN_TOKEN=admin
# Необов'язкові read-only ключі для перевірки мереж/контрактів (приватні ендпоінти OKX і Bybit).
# Без них дані про мережі OKX/Bybit вважаються неперевіреними, а прибуток — попереднім.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Необов'язково: read-only ключі для комісій/мереж
GATE_API_KEY=
GATE_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
